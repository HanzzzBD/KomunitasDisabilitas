# Template environment Incasif — KATALOG seluruh variabel monorepo.
#
# ⚠ PENTING — LOKASI FILE .env NYATA:
#   File .env TIDAK dibaca dari root. Tiap app membaca .env dari foldernya
#   sendiri. Untuk backend API + Prisma:
#     cp apps/api/.env.example apps/api/.env
#   (Prisma CLI hanya membaca apps/api/.env — .env di root diabaikan.)
#
# JANGAN commit file .env berisi nilai nyata (ADR-015; .gitignore sudah menutup).
# Daftar ini tumbuh per PR — skema & validasi di apps/api/src/core/config/env.ts.

# --- Runtime (PR-006) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database & queue (PR-006 validasi; compose dev = PR-008) ---
# Port host compose dev: Postgres 5433 (hindari bentrok Postgres lokal 5432).
DATABASE_URL=postgresql://incasif:incasif@localhost:5433/incasif
# Redis cache (allkeys-lru) dan queue (noeviction) adalah dua service terpisah
# (ADR-004 revisi). Port host compose dev: cache 6379, queue 6380.
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# --- core/http (PR-007) ---
# Whitelist origin CORS, pisahkan dengan koma (exact match).
CORS_ORIGINS=http://localhost:5173
# Rate limit global per IP (Redis store menyusul PR-008).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- Menyusul (placeholder, JANGAN diisi sebelum PR terkait) ---
# FIELD_KEY_V1=            # PR-013: kunci AES-256-GCM 32-byte (base64)
# GEMINI_API_KEY=          # PR-033: AI Gateway
# GROQ_API_KEY=            # PR-033: AI Gateway (fallback)
