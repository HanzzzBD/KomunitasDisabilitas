# Template environment Incasif — salin ke .env.local / .env dan isi nilai lokal.
# JANGAN commit file .env berisi nilai nyata (ADR-015; .gitignore sudah menutup).
# Daftar ini tumbuh per PR — skema & validasi di apps/api/src/core/config/env.ts.

# --- Runtime (PR-006) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database & queue (PR-006 validasi; koneksi nyata mulai PR-008/010) ---
DATABASE_URL=postgresql://incasif:incasif@localhost:5432/incasif
REDIS_URL=redis://localhost:6379

# --- Menyusul (placeholder, JANGAN diisi sebelum PR terkait) ---
# FIELD_KEY_V1=            # PR-013: kunci AES-256-GCM 32-byte (base64)
# GEMINI_API_KEY=          # PR-033: AI Gateway
# GROQ_API_KEY=            # PR-033: AI Gateway (fallback)
