{
  "name": "@nawasena/web",
  "version": "0.0.0",
  "private": true,
  "description": "React 18 + Vite web app (SDD §4.1).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "lint": "eslint src __tests__ scripts e2e --ext .ts,.tsx,.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "cek:budget": "tsx scripts/cek-budget.ts",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json",
    "test:lighthouse:3g": "lhci autorun --config=lighthouserc-3g.json"
  },
  "dependencies": {
    "@nawasena/a11y": "workspace:*",
    "@nawasena/api-client": "workspace:*",
    "@nawasena/schemas": "workspace:*",
    "@nawasena/ui": "workspace:*",
    "@tanstack/react-query": "5.62.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.1.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@nawasena/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
