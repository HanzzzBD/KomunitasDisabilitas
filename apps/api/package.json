{
  "name": "@incasif/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express backend Incasif (monolith modular, ADR-001/002).",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src __tests__ --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "4.21.2",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@incasif/config": "workspace:*",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "eslint": "8.57.1",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
