{
  "name": "@nawasena/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ worker (codebase sama dengan api, entry berbeda).",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nawasena/api": "workspace:*",
    "@nawasena/schemas": "workspace:*",
    "bullmq": "5.81.2",
    "pino": "9.5.0",
    "puppeteer-core": "24.43.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@nawasena/config": "workspace:*",
    "@types/node": "22.10.2",
    "eslint": "8.57.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
