{
  "extends": ["expo/tsconfig.base", "@nawasena/config/tsconfig/base"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["react-native"]
  },
  "include": ["index.ts", "app.config.ts", "src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", ".expo"]
}
