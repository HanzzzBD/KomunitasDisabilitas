{
  "name": "@nawasena/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Aplikasi Android Nawasena — Expo managed + React Navigation (ADR-011, SDD §4.2).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "eslint src __tests__ index.ts app.config.ts metro.config.js --ext .ts,.tsx,.js --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:navigation",
    "test:navigation": "node ../../packages/ui-native/node_modules/jest/bin/jest.js --config jest.navigation.config.cjs --runInBand",
    "build:internal": "eas build --profile internal --platform android"
  },
  "dependencies": {
    "@nawasena/a11y": "workspace:*",
    "@nawasena/api-client": "workspace:*",
    "@nawasena/formulir": "workspace:*",
    "@nawasena/lowongan": "workspace:*",
    "@nawasena/schemas": "workspace:*",
    "@nawasena/ui-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@tanstack/react-query": "5.62.11",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-intent-launcher": "57.0.1",
    "expo-linking": "57.0.11",
    "expo-notifications": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@nawasena/config": "workspace:*",
    "@types/react": "19.2.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "react-dom": "19.2.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
