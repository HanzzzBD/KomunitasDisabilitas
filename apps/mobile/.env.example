# Salin file ini menjadi apps/mobile/.env (JANGAN commit — .gitignore menutup).
#   cp apps/mobile/.env.example apps/mobile/.env
#
# Konvensi repo (ADR-015): .env.example hidup PER APP, di folder app yang
# membacanya. File ini HANYA untuk apps/mobile; backend: apps/api/.env.example.
#
# SIAPA YANG MEMUAT FILE INI:
#   - Expo CLI (`pnpm --filter @nawasena/mobile start` / `expo export`) memuat
#     .env dari folder ini secara otomatis.
#   - Build EAS TIDAK membaca file ini: .env di-gitignore, jadi tidak ikut
#     diunggah. Nilai untuk build internal diisi di environment EAS `preview`
#     (eas.json → profil `internal`). Lihat README.md bagian "Build internal".
#
# PERINGATAN: semua variabel `EXPO_PUBLIC_*` DI-INLINE ke dalam APK saat bundling.
# Isinya PUBLIK — siapa pun yang membongkar APK bisa membacanya. JANGAN pernah
# menaruh rahasia (client secret, API key privat, token) di variabel apa pun di
# file ini.

# --- API -------------------------------------------------------------------
# URL dasar API tanpa garis miring penutup.
# - Dev (Metro): kosongkan → otomatis http://10.0.2.2:3000/api/v1 (localhost
#   mesin host dilihat dari emulator Android).
# - HP fisik di LAN: http://<ip-laptop>:3000/api/v1
# - Build non-dev / EAS: WAJIB https:// — kalau tidak, app.config.ts
#   menghentikan build dan src/config.ts menolak saat runtime.
EXPO_PUBLIC_API_URL=

# --- Masuk dengan Google (PR-090) -----------------------------------------
# Web OAuth Client ID — SAMA dengan GOOGLE_CLIENT_ID di apps/api/.env. Dipakai
# sebagai `serverClientId` Credential Manager, sehingga id_token ber-aud ID ini
# dan diterima verifier API. Ini ID publik, bukan rahasia.
# Kosong / bukan *.apps.googleusercontent.com → tombol Google disembunyikan.
# Butuh juga OAuth client tipe Android (package id.nawasena.app + SHA-1
# keystore) di Google Cloud Console — tidak diisi di sini.
# Contoh: 123456789012-abcdefg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Sakelar rollback fitur -------------------------------------------------
# Bawaan AKTIF. Hanya nilai persis "false" yang mematikan, jadi build yang lupa
# menyetel tetap menampilkan fiturnya.
# Wizard onboarding aksesibilitas (PR-091; paritas VITE_ONBOARDING_WIZARD_ENABLED).
EXPO_PUBLIC_ONBOARDING_WIZARD_ENABLED=true
# Feed rekomendasi di tab Beranda (PR-093; paritas VITE_MATCHING_FEED_ENABLED).
# "false" → Beranda cadangan yang mengarahkan ke tab Cari.
EXPO_PUBLIC_MATCHING_FEED_ENABLED=true

# --- EAS (opsional, hanya untuk menjalankan build dari mesin lokal) --------
# projectId dari `npx eas-cli init` — sengaja TIDAK ditulis di repo.
# app.config.ts membacanya dari env; isi di sini ATAU export di shell sebelum
# `pnpm --filter @nawasena/mobile build:internal`.
EAS_PROJECT_ID=

# --- Push FCM (PR-094) ------------------------------------------------------
# Lokal: path google-services.json Android (package id.nawasena.app), di-ignore.
# EAS preview: GOOGLE_SERVICES_JSON bertipe File. Kosong = push belum tersedia;
# apply/tracking tetap berjalan. Ini bukan private key service account backend.
GOOGLE_SERVICES_JSON=

# --- Statistik anonim Umami (PR-094) ---------------------------------------
# Opsional. HTTPS + website ID UUID khusus mobile; kosong = analytics no-op.
# Pilihan opt-out per HP tersedia di tab Profil. Semua EXPO_PUBLIC_* bersifat publik.
EXPO_PUBLIC_UMAMI_URL=
EXPO_PUBLIC_UMAMI_WEBSITE_ID=

# Catatan: EAS_BUILD diset otomatis oleh mesin build EAS — jangan diisi.
