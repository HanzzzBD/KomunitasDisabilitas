{
  "name": "@nawasena/schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Kontrak zod tunggal FE+BE+mobile; OpenAPI di-generate dari zod (SDD §11).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src scripts __tests__ --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "check:openapi": "tsx scripts/gen-openapi.ts --check"
  },
  "dependencies": {
    "zod": "3.24.1",
    "zod-openapi": "4.2.4"
  },
  "devDependencies": {
    "@nawasena/config": "workspace:*",
    "@types/node": "22.10.2",
    "eslint": "8.57.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
