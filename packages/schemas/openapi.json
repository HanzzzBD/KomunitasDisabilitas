{
  "openapi": "3.1.0",
  "info": {
    "title": "Nawasena API",
    "version": "0.1.0",
    "description": "Kontrak API Nawasena — di-generate dari zod di packages/schemas. Jangan edit openapi.json manual; jalankan pnpm --filter @nawasena/schemas gen:openapi."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/otp/request": {
      "post": {
        "operationId": "requestOtp",
        "tags": [
          "auth"
        ],
        "summary": "Minta kode OTP",
        "security": [],
        "description": "Mengirim kode OTP ke nomor HP via WhatsApp/SMS.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOtp"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "OTP dikirim",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestOtpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Terlalu banyak permintaan — lihat header Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Pengiriman OTP belum dikonfigurasi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "operationId": "verifyOtp",
        "tags": [
          "auth"
        ],
        "summary": "Verifikasi kode OTP",
        "security": [],
        "description": "Memeriksa kode OTP. Bila cocok, akun dicari berdasarkan nomor HP dan dibuat bila belum ada (find-or-create).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtp"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kode cocok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOtpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Kode salah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Kode hangus atau kedaluwarsa — minta kode baru",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Percobaan terkunci sementara — lihat header Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "operationId": "loginWithGoogle",
        "tags": [
          "auth"
        ],
        "summary": "Masuk dengan Google",
        "security": [],
        "description": "Menukar authorization code Google (dengan PKCE code_verifier) menjadi sesi. id_token diverifikasi terhadap kunci publik Google (audience, issuer, kedaluwarsa). Akun dicari berdasarkan google_id, lalu email terverifikasi, dan dibuat bila belum ada (find-or-create).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuth"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Masuk berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoogleAuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Code/verifier ditolak Google, atau id_token tidak sah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Email Google belum terverifikasi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Login Google belum dikonfigurasi atau Google tidak terjangkau",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "tags": [
          "auth"
        ],
        "summary": "Perpanjang sesi",
        "security": [],
        "description": "Menukar refresh token dengan pasangan token baru. Klien web tidak mengirim body: tokennya ada di cookie HttpOnly yang dilampirkan browser, dan token barunya dikembalikan sebagai cookie pula. Klien mobile mengirim dan menerima refresh token di body untuk disimpan di SecureStore.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesi diperpanjang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Input tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token tidak dikenal, kedaluwarsa, atau sudah dicabut",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Sesi belum dikonfigurasi (kunci RS256 tidak tersedia)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestOtp": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+62\\d{8,13}$",
            "description": "Nomor HP Indonesia, format E.164",
            "example": "+6281234567890"
          }
        },
        "required": [
          "phone"
        ],
        "description": "Permintaan kirim kode OTP via WhatsApp/SMS"
      },
      "RequestOtpResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "retryAfterSeconds": {
                "type": "integer",
                "minimum": 0,
                "example": 0
              }
            },
            "required": [
              "retryAfterSeconds"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Kode error mesin, UPPER_SNAKE_CASE",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Pesan untuk pengguna, Bahasa Indonesia sederhana",
            "example": "Input tidak valid"
          },
          "hint": {
            "type": "string",
            "description": "Saran perbaikan untuk pengguna",
            "example": "Periksa format nomor HP Anda"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "description": "Envelope error standar Nawasena"
      },
      "VerifyOtp": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+62\\d{8,13}$",
            "description": "Nomor HP Indonesia, format E.164",
            "example": "+6281234567890"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "Kode OTP 6 angka dari WhatsApp/SMS",
            "example": "482913"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web",
            "description": "Jenis klien — menentukan cookie vs body",
            "example": "web"
          }
        },
        "required": [
          "phone",
          "code"
        ],
        "description": "Verifikasi kode OTP yang diterima pengguna"
      },
      "VerifyOtpResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid",
                "description": "UUID",
                "example": "01912345-89ab-7def-8123-456789abcdef"
              },
              "isNewUser": {
                "type": "boolean",
                "example": false
              },
              "accessToken": {
                "type": "string",
                "minLength": 1,
                "description": "JWT RS256, berlaku 15 menit"
              },
              "expiresIn": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "example": 900
              },
              "refreshToken": {
                "type": "string",
                "minLength": 1,
                "description": "Hanya untuk client=mobile; web menerimanya sebagai cookie"
              }
            },
            "required": [
              "userId",
              "isNewUser",
              "accessToken",
              "expiresIn"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "GoogleAuth": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Authorization code sekali pakai dari Google"
          },
          "codeVerifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9\\-._~]{43,128}$",
            "description": "PKCE code_verifier (RFC 7636), 43–128 karakter"
          },
          "redirectUri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "example": "http://localhost:5173/masuk/google"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web",
            "description": "Jenis klien — menentukan cookie vs body",
            "example": "web"
          }
        },
        "required": [
          "code",
          "codeVerifier",
          "redirectUri"
        ],
        "description": "Tukar authorization code Google (PKCE) jadi sesi"
      },
      "GoogleAuthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid",
                "description": "UUID",
                "example": "01912345-89ab-7def-8123-456789abcdef"
              },
              "isNewUser": {
                "type": "boolean",
                "example": false
              },
              "accessToken": {
                "type": "string",
                "minLength": 1,
                "description": "JWT RS256, berlaku 15 menit"
              },
              "expiresIn": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "example": 900
              },
              "refreshToken": {
                "type": "string",
                "minLength": 1,
                "description": "Hanya untuk client=mobile; web menerimanya sebagai cookie"
              }
            },
            "required": [
              "userId",
              "isNewUser",
              "accessToken",
              "expiresIn"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "RefreshSession": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Hanya untuk client mobile; web memakai cookie"
          }
        },
        "description": "Perpanjang sesi dengan refresh token"
      },
      "RefreshSessionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionTokens"
          }
        },
        "required": [
          "data"
        ]
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1,
            "description": "JWT RS256, berlaku 15 menit"
          },
          "expiresIn": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "description": "Hanya untuk client=mobile; web menerimanya sebagai cookie"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      }
    }
  }
}
