{
  "extends": "./tsconfig/node.json",
  "compilerOptions": {
    // File di paket ini (test + vitest config) di-typecheck sebagai ESM oleh Vitest.
    // Override module resolution ke Bundler & matikan verbatimModuleSyntax di sini
    // saja — preset yang dikonsumsi paket lain (tsconfig/*.json) tidak terpengaruh.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // fixtures/ sengaja memuat kode pelanggaran (mis. impor SDK AI yang tidak
  // di-install) untuk membuktikan gate lint bekerja — bukan untuk di-typecheck.
  "exclude": ["node_modules", "dist", "build", "coverage", "fixtures"]
}
