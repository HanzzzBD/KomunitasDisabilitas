{
  "name": "nawasena",
  "version": "0.0.0",
  "private": true,
  "description": "Nawasena — Inclusive Career Ecosystem for People with Disabilities (monorepo)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md}\""
  },
  "devDependencies": {
    "@nawasena/config": "workspace:*",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
